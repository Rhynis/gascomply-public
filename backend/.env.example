# GasComply backend - copy to .env and adjust. Never commit a real .env.
# Every field app/core/config.py's Settings reads has a line below
# (tests/test_config.py fails if one is ever missing). No secret belongs here.

# local | ci | production
APP_ENV=local

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Postgres + pgvector (build plan A6 Phase 1.5b). Unset = no database: the ingest
# CLI runs dry (no persistence) and app/core/migrate.py refuses to run.
# Local development: `docker compose up -d` at the repo root starts this image.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/gascomply

# mock | bge-m3 (build plan A6 Phase 1.5c). mock needs no Ollama and runs the ingest
# pipeline and /ask offline (used by the test suite). bge-m3 is what the README's
# local setup actually runs, and requires a running Ollama daemon (`ollama serve`)
# with the model pulled (`ollama pull bge-m3`).
EMBEDDER=bge-m3

# Only read when EMBEDDER=bge-m3 or LLM_PROVIDER=ollama. `ollama serve`'s own default port.
OLLAMA_BASE_URL=http://localhost:11434

# mock | ollama (A6 Phase 3.7). mock needs no Ollama and is what the test suite and a
# docs-only clone use. ollama is what the README's local setup actually runs, and
# requires a running Ollama daemon with OLLAMA_MODEL pulled.
LLM_PROVIDER=ollama

# Chat model OllamaProvider asks Ollama for, only read when LLM_PROVIDER=ollama. The
# default dev model since issue #156 (`ollama pull qwen3:8b`).
OLLAMA_MODEL=qwen3:8b

# Context window, in tokens, sent on every Ollama chat call (issue #129). Ollama's own
# default (4096) silently truncates the front of a long generation prompt. 16384 clears
# the largest observed generation prompt with headroom; raising it needs a fresh memory
# measurement first (`ollama ps` with qwen3:8b, the default chat model since issue #156,
# and bge-m3 both loaded).
OLLAMA_NUM_CTX=16384

# none | mock | llama-server (issue #114). none, the default, skips reranking. llama-server
# reranks the retrieved passages with a real cross-encoder (bge-reranker-v2-m3) served by a
# `llama-server --rerank` sidecar -- NOT Ollama, which has no rerank endpoint. See
# docs/adr/0002-cross-encoder-reranker-runtime.md for the command. If the sidecar is down,
# /ask logs a warning and answers as if RERANKER=none.
RERANKER=none

# Only read when RERANKER=llama-server.
RERANKER_BASE_URL=http://localhost:8081

# How many passages survive reranking (only read when RERANKER is not none). Chosen by
# measurement -- see the ADR.
RERANK_TOP_N=5

# Whether generation verifies that each cited clause supports the answer before it ships
# (issue #90). True is what /ask actually runs with; false is for debugging the raw model
# output only, never for a deployed answer.
GROUNDING_CHECK=true
